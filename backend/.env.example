PORT=5001
# Local development:
MONGO_URI=mongodb://127.0.0.1:27017/sims
# Render/production: set MONGO_URI to your MongoDB Atlas connection string instead.
# Example: mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/sims?retryWrites=true&w=majority
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173,http://localhost:5174
NODE_ENV=development
